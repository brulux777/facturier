# Facturier — configuration serveur (copier vers .env, ne jamais committer)
#
# Authentification multi-comptes (table `users`, base du facturier) :
#   ALLOWED_EMAIL_DOMAINS   domaines de connexion séparés par des virgules
#                           (création de compte libre pour ces domaines)
#   AUTH_EMAIL /            compte initial UNIQUE : importé dans `users`
#   AUTH_PASSWORD_SHA256    seulement si la table est vide (premier
#                           démarrage) ; le hash est ensuite migré en
#                           scrypt à la première connexion
# Session :
#   SESSION_SECRET          secret HMAC long : openssl rand -hex 32
#   SESSION_TTL_DAYS        durée de la session (déf. 30 jours)
#   COOKIE_SECURE=1         cookie Secure (HTTPS) — 1 en production derrière nginx
# Mails (réinitialisation de mot de passe) :
#   SMTP_HOST / SMTP_PORT   serveur SMTP (465 = SSL implicite)
#   SMTP_USER / SMTP_PASS   identifiants du compte d'envoi
#   SMTP_FROM               expéditeur affiché (déf. SMTP_USER)
#   APP_URL                 URL publique de l'instance (déf. déduite des
#                           en-têtes X-Forwarded-*) — liens des emails
# PostgreSQL (conteneur db, base dédiée au facturier) :
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB

ALLOWED_EMAIL_DOMAINS=hoplacollect.fr,eldcontrole.fr,controleweb.fr

SESSION_SECRET=remplacer_par_openssl_rand_hex_32
SESSION_TTL_DAYS=30
COOKIE_SECURE=1

SMTP_HOST=mail.example.fr
SMTP_PORT=465
SMTP_USER=facturier@example.fr
SMTP_PASS=remplacer
SMTP_FROM=Facturier <facturier@example.fr>

POSTGRES_USER=facturier
POSTGRES_PASSWORD=remplacer_par_openssl_rand_hex_16
POSTGRES_DB=facturier
